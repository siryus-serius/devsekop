{
  "name": "vault-ijazah-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Aplikasi Vault Dokumen dan Sertifikat Digital Berbasis Web (Ijazah Digital Berbasis Blockchain)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.hardhat.json --noEmit",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:abi": "hardhat compile && node scripts/export-abi.mjs",
    "chain:node": "hardhat node",
    "chain:deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "chain:deploy:testnet": "hardhat run scripts/deploy.ts --network baseSepolia",
    "keys:generate": "node scripts/generate-keys.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "viem": "^2.57.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "hardhat": "^2.29.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    },
    "lodash": "^4.18.1",
    "tmp": "^0.2.7",
    "serialize-javascript": "^7.1.4"
  }
}
