# Copy to .env.local and fill in. Never commit the real file.

# "supabase" or "memory". Defaults to supabase when SUPABASE_URL is set.
REGISTRY_BACKEND=supabase

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret (service_role key, or the newer sb_secret_... key).
# Do NOT prefix with NEXT_PUBLIC_ — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
