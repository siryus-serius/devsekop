# =============================================================================
# Template variabel lingkungan — salin ke .env.local dan isi nilainya.
# JANGAN PERNAH commit .env.local atau secret asli ke repositori.
# Buat material kunci lokal dengan:  npm run keys:generate
# =============================================================================

# --- Aplikasi -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin pihak ketiga yang boleh memanggil POST /api/verify (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# HANYA SERVER — melewati RLS. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Simulasi HSM/KMS (HANYA SERVER) -------------------------------------------
# Produksi: ganti dengan KMS terkelola (AWS KMS / GCP KMS / Vault) — kunci tidak pernah diekspor.
# Kunci master AES-256 (32 byte, base64) untuk membungkus DEK & mengenkripsi field PII
KMS_MASTER_KEY=
# Kunci privat secp256k1 issuer untuk menandatangani payload ijazah (0x + 64 hex)
KMS_ISSUER_SIGNER_KEY=
# Pepper HMAC untuk token tautan berbagi (min. 32 karakter)
SHARE_TOKEN_PEPPER=

# --- Blockchain ----------------------------------------------------------------
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DIPLOMA_REGISTRY_ADDRESS=
# Akun relayer server (approver #1 multi-sig) yang membayar gas (0x + 64 hex)
ISSUER_RELAYER_PRIVATE_KEY=

# Deployment kontrak
MULTISIG_THRESHOLD=2
# Approver tambahan (alamat, pisahkan dengan koma). Lokal: default akun Hardhat #2
APPROVER_ADDRESSES=
# Produksi: alamat Safe multisig sebagai admin kontrak
REGISTRY_ADMIN_ADDRESS=
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# --- Keamanan unggahan & rate limiting -----------------------------------------
# Wajib di produksi (fail-closed): host clamd untuk pemindaian malware
CLAMAV_HOST=
CLAMAV_PORT=3310
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_VERIFY_MAX=30
RATE_LIMIT_WINDOW_MS=60000
